# Quality Guardian — configuration reference. Copy to .env and fill in the key.
#   cp .env.example .env  &&  edit ANTHROPIC_API_KEY

# --- Agent LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Hub Ledger (Postgres on host :5442) ---
GUARDIAN_PG_HOST=localhost
GUARDIAN_PG_PORT=5442
GUARDIAN_PG_DB=dataops
GUARDIAN_PG_USER=dataops
GUARDIAN_PG_PASSWORD=dataops123

# --- Validation window (N most recent records) ---
GUARDIAN_WINDOW=50

# --- Models (evaluator-optimizer: cheap proposes, strong judges) ---
GUARDIAN_LLM_MODEL=anthropic:claude-sonnet-4-6
GUARDIAN_GENERATOR_MODEL=anthropic:claude-haiku-4-5
GUARDIAN_EVALUATOR_MODEL=anthropic:claude-sonnet-4-6
